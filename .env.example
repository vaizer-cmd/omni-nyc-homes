# Contact form — Microsoft Graph (app-only OAuth2) email sending.
# Copy to .env.local and fill in. Used by api/contact.ts via `vercel dev`.

# Microsoft Entra ID app registration (required to send via Graph)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Licensed M365 mailbox that SENDS the email (must be a real mailbox the app
# has Mail.Send permission for). Also the default recipient.
NAMECHEAP_EMAIL=info@omnipropm.com

# Optional: override who RECEIVES the email. Set to your test inbox locally.
# Falls back to NAMECHEAP_EMAIL when unset (production behavior).
CONTACT_RECIPIENT=
